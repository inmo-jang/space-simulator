<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="space-simulator">
    <Fallback>
      <Sequence>
        <IsBatteryLow/>
        <Sequence>
        <Fallback>
          <IsArrivedAtChargingStation/>
          <GoToChargingStation/>
        </Fallback>
        <ChargeBattery/>
      </Sequence>
    </Sequence>
    <Sequence>
      <LocalSensingNode/>
      <Fallback>
        <IsFinishedTask/>
        <Sequence>
          <Fallback>
            <IsHoldingItem/>
            <Sequence>
              <Fallback>
                <IsArrivedAtShip/>
                <Sequence>
                  <DecideShip/>
                  <GoToShip/>
                </Sequence>
              </Fallback>
              <PickItem/>
            </Sequence>
          </Fallback>
          <Fallback>
            <IsArrivedAtDestination/>
            <GoToDestination/>
          </Fallback>
          <PlaceItem/>
        </Sequence>
      </Fallback>
    </Sequence>
  </Fallback>
</BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="GoToDestination"
            editable="true"/>
    <Action ID="GoToShip"
            editable="true"/>
    <Condition ID="IsArrivedAtDestination"
               editable="true"/>
    <Condition ID="IsArrivedAtShip"
               editable="true"/>
    <Condition ID="IsArrivedAtChargingStation"
               editable="true"/>           
    <Condition ID="IsFinishedTask"
               editable="true"/>
    <Condition ID="IsHoldingItem"
               editable="true"/>
    <Condition ID="IsBatteryLow"
               editable="true"/>
    <Action ID="LocalSensingNode"
            editable="true"/>
    <Action ID="PickItem"
            editable="true"/>
    <Action ID="PlaceItem"
            editable="true"/>
    <Action ID="DecideShip"
            editable="true"/>
    <Action ID="GoToChargingStation"
            editable="true"/>
    <Action ID="ChargeBattery"
            editable="true"/>
  </TreeNodesModel>

</root>
