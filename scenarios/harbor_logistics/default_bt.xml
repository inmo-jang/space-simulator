<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="space-simulator">
    <Sequence>
      <Fallback>
        <IsBatterySufficient/>
        <Sequence>
          <Fallback>
            <IsArrivedAtChargingStation/>
            <GoToChargingStation/>
          </Fallback>
          <ChargeBattery/>
        </Sequence>
      </Fallback>
      <Sequence>
        <LocalSensingNode/>
        <Fallback>
          <IsFinishedTask/>
          <Sequence>
            <Fallback>
              <IsHoldingItem/>
              <Sequence>
                <Fallback>
                  <IsArrivedAtShip/>
                  <Sequence>
                    <DecideShip/>
                    <GoToShip/>
                  </Sequence>
                </Fallback>
                <PickItem/>
              </Sequence>
            </Fallback>
            <Fallback>
              <IsArrivedAtDestination/>
              <GoToDestination/>
            </Fallback>
            <PlaceItem/>
          </Sequence>
        </Fallback>
      </Sequence>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="GoToDestination"
            editable="true"/>
    <Action ID="DecideShip"
            editable="true"/>
    <Action ID="GoToShip"
            editable="true"/>
    <Condition ID="IsArrivedAtDestination"
               editable="true"/>
    <Condition ID="IsArrivedAtShip"
               editable="true"/>
    <Condition ID="IsArrivedAtChargingStation"
               editable="true"/>
    <Condition ID="IsFinishedTask"
               editable="true"/>
    <Condition ID="IsHoldingItem"
               editable="true"/>
    <Action ID="LocalSensingNode"
            editable="true"/>
    <Action ID="PickItem"
            editable="true"/>
    <Action ID="PlaceItem"
            editable="true"/>
    <Condition ID="IsBatterySufficient"
               editable="true"/>
    <Action ID="GoToChargingStation"
            editable="true"/>
    <Action ID="ChargeBattery"
            editable="true"/>
  </TreeNodesModel>

</root>
