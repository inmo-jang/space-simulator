<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="space-simulator">
    <ReactiveSequence>
      <GatherLocalInfo/>
      <Sequence>
        <ReactiveSequence>
          <ReactiveSequence>
            <ReactiveFallback>
              <AssignTask/>
              <Explore/>
            </ReactiveFallback>
            <SelectVertex/>
          </ReactiveSequence>
          <ReactiveSequence>
            <ReactiveFallback>
              <IsArrivedAtBlockTask/>
              <MoveToBlockTask/>
            </ReactiveFallback>
            <ReactiveFallback>
              <IsAllAgents/>
              <WaitAgents/>
            </ReactiveFallback>
          </ReactiveSequence>
        </ReactiveSequence>
        <ReactiveFallback>
          <IsBlockTaskLifted/>
          <LiftBlockTask/>
        </ReactiveFallback>
        <ReactiveFallback>
          <IsSlotTaskCompleted/>
          <ReactiveSequence>
            <ReactiveFallback>
              <IsArrivedAtSlotTask/>
              <MoveToSlotTask/>
            </ReactiveFallback>
            <PlaceDownBlockTask/>
          </ReactiveSequence>
        </ReactiveFallback>
      </Sequence>
    </ReactiveSequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AssignTask"
            editable="true"/>
    <Action ID="Explore"
            editable="true"/>
    <Action ID="GatherLocalInfo"
            editable="true"/>
    <Condition ID="IsAllAgents"
               editable="true"/>
    <Condition ID="IsArrivedAtBlockTask"
               editable="true"/>
    <Condition ID="IsArrivedAtSlotTask"
               editable="true"/>
    <Condition ID="IsBlockTaskLifted"
               editable="true"/>
    <Condition ID="IsSlotTaskCompleted"
               editable="true"/>
    <Action ID="LiftBlockTask"
            editable="true"/>
    <Action ID="MoveToBlockTask"
            editable="true"/>
    <Action ID="MoveToSlotTask"
            editable="true"/>
    <Action ID="PlaceDownBlockTask"
            editable="true"/>
    <Action ID="SelectVertex"
            editable="true"/>
    <Action ID="WaitAgents"
            editable="true"/>
  </TreeNodesModel>

</root>
